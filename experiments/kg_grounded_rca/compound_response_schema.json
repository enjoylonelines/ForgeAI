{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "diagnosis",
    "action_plan",
    "claims",
    "uncertainties"
  ],
  "properties": {
    "scenario_id": {
      "type": "string"
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_failure_mode",
        "contributing_failure_modes",
        "root_cause",
        "causal_chain",
        "confidence"
      ],
      "properties": {
        "primary_failure_mode": {
          "type": "string"
        },
        "contributing_failure_modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "root_cause": {
          "type": "string"
        },
        "causal_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "statement",
              "evidence_ids"
            ],
            "properties": {
              "statement": {
                "type": "string"
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "action_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_number",
          "action",
          "evidence_ids"
        ],
        "properties": {
          "step_number": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "evidence_ids"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
