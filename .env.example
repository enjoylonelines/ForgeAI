# Ollama
# 로컬 직접 실행: http://localhost:11434
# docker compose 환경: http://ollama:11434 (compose에서 자동 주입)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120.0
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=512

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=sop_documents

# RAG
GROUNDING_SCORE_THRESHOLD=0.75
CHUNK_SIZE=1024
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5

# Server
PORT=8000
LOG_LEVEL=INFO

# Pipeline
PIPELINE_MAX_RETRIES=2
CONTROL_ADAPTER_PATH=./build/control_adapter

# Langfuse LLM 추적 (https://langfuse.com 에서 키 발급)
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
